<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ p.name }} | Limnology & Freshwater Ecology</title>
<meta name="description" content="{{ p.name }}, {{ p.position }}. {{ p.summary }}">
<meta property="og:title" content="{{ p.name }}">
<meta property="og:description" content="{{ p.position }}">
<meta property="og:image" content="assets/banner.jpg">
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Public+Sans:wght@400;500;600&display=swap">
<style>
:root{--bg:#FAFBFA;--ink:#16211F;--muted:#5E6B68;--line:#DDE3E1;--accent:#0F5E5A;--tint:#E6F0EE;color-scheme:light}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Public Sans",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
a:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
.serif{font-family:"Newsreader",Georgia,"Times New Roman",serif}

.nav{position:sticky;top:0;z-index:5;background:rgba(250,251,250,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav-in{max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px clamp(16px,4vw,48px)}
.brand{font-size:19px;font-weight:500;text-decoration:none}
.nav ul{display:flex;align-items:center;gap:clamp(14px,2.5vw,26px);list-style:none;margin:0;padding:0;font-size:14px;color:var(--muted)}
.nav ul a{text-decoration:none}
.nav ul a:hover{color:var(--ink)}

.banner{height:clamp(160px,26vw,300px);overflow:hidden;-webkit-mask-image:linear-gradient(to bottom,#000 45%,transparent);mask-image:linear-gradient(to bottom,#000 45%,transparent)}
.banner img{width:100%;height:100%;object-fit:cover;object-position:50% 45%;display:block}

.body{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:minmax(260px,300px) 1fr;gap:clamp(28px,5vw,72px);padding:0 clamp(16px,4vw,48px) 72px}
aside{display:flex;flex-direction:column;gap:16px;align-self:start}
.photo{width:164px;height:auto;max-width:100%;aspect-ratio:1;border-radius:50%;margin-top:-82px;border:5px solid #fff;box-shadow:0 1px 2px rgba(22,33,31,.12),0 4px 14px rgba(22,33,31,.14);position:relative;object-fit:cover;background:var(--tint);display:block}
h1.name{font-weight:500;font-size:36px;line-height:1.1;margin:0;letter-spacing:-.01em}
.role{color:var(--muted);margin:0;font-size:14px}
.icons{display:flex;gap:10px;flex-wrap:wrap}
.icons button{font:inherit;cursor:pointer;padding:0}
.icons a,.icons button{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;color:var(--accent);background:#fff;transition:background .15s,border-color .15s,color .15s}
.icons a:hover,.icons button:hover{color:#fff;border-color:transparent}
.icons a.orcid:hover{background:#A6CE39}
.icons a.rg:hover{background:#00CCBB}
.icons a.li:hover{background:#0A66C2}
.icons .mail:hover{background:var(--accent)}
.check{border:1px solid var(--line);border-radius:10px;padding:22px 22px 18px;width:min(340px,calc(100vw - 32px));background:var(--bg);color:var(--ink);box-shadow:0 12px 40px rgba(22,33,31,.18)}
.check::backdrop{background:rgba(22,33,31,.35)}
.check h2{margin:0 0 6px;font-size:20px;font-weight:500}
.check p{margin:0 0 14px;color:var(--muted);font-size:14px}
.check label{display:block;font-size:14px;margin-bottom:6px}
.check input{width:100%;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--ink)}
.check input:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.check .err{color:#A33A2B;font-size:13px;margin:6px 0 0;min-height:1.2em}
.check .row{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}
.check button{font:inherit;font-size:14px;font-weight:600;border-radius:6px;padding:8px 14px;cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink)}
.check button[type=submit]{background:var(--accent);border-color:var(--accent);color:#fff}
.check .manual{margin:8px 0 0;font-size:14px;color:var(--ink);user-select:all;overflow-wrap:anywhere}
.toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,12px);background:var(--ink);color:#fff;font-size:14px;padding:10px 16px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:20}
.toast.show{opacity:1;transform:translate(-50%,0)}
.icons svg{width:20px;height:20px;display:block}
.cv{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;text-decoration:none;background:var(--accent);color:#fff;padding:9px 16px;border-radius:6px}
.cv:hover{background:#0B4B48}
.cv svg{width:16px;height:16px}
.album{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}
.album a{position:relative;display:block;overflow:hidden;border-radius:4px;background:var(--tint);cursor:zoom-in}
.album img{position:absolute;max-width:none;height:auto;display:block}
.album .wide{grid-column:span 2}
.lb{padding:0;border:0;background:transparent;max-width:94vw;max-height:94vh;overflow:visible}
.lb::backdrop{background:rgba(10,16,15,.86)}
.lb img{display:block;max-width:94vw;max-height:94vh;width:auto;height:auto;cursor:zoom-out}
.lede strong{font-weight:500;color:var(--accent)}
.scenery-wrap{position:relative;margin-top:-24px}
.scenery-wrap footer{position:absolute;left:0;right:0;bottom:0;border:0;color:rgba(255,255,255,.88);text-shadow:0 1px 3px rgba(0,0,0,.35)}
.scenery{display:block;width:100%;height:clamp(220px,32vw,460px);object-fit:cover;object-position:50% 62%;
  -webkit-mask-image:linear-gradient(to bottom,transparent,#000 55%);mask-image:linear-gradient(to bottom,transparent,#000 55%)}

main{display:flex;flex-direction:column;gap:48px;min-width:0;padding-top:clamp(28px,4vw,44px)}
.lede{font-size:clamp(20px,2.2vw,25px);line-height:1.45;margin:0;max-width:34em;text-wrap:pretty}
section[id]{scroll-margin-top:72px}
h2.sec{margin:0 0 24px;font-size:26px;font-weight:500;padding-bottom:10px;border-bottom:1px solid var(--line)}
.themes{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px}
.themes div{border-top:1px solid var(--ink);padding-top:10px}
.themes b{display:block;font-weight:600;margin-bottom:4px}
.themes p{margin:0;color:var(--muted);font-size:14px}
.cv-list{display:grid;grid-template-columns:110px 1fr;gap:10px 18px;margin:0;font-size:14.5px}
.cv-list dt{color:var(--muted);font-variant-numeric:tabular-nums}
.cv-list dd{margin:0}
.sub{margin:22px 0 10px;font-size:13px;font-weight:600;color:var(--muted)}

.pubgroups{display:flex;flex-direction:column;gap:32px}
h3.grp{margin:0 0 14px;font-size:13px;font-weight:600;letter-spacing:.06em;color:var(--accent)}
.pubs{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px}
.pubs li{display:grid;grid-template-columns:40px 1fr;gap:10px;font-size:14px}
.pubs .no{font-variant-numeric:tabular-nums;color:var(--accent);font-weight:500;padding-top:3px}
.pubs .t{font-size:17.5px;line-height:1.38;display:block;margin-bottom:4px}
.pubs .m{color:var(--muted);overflow-wrap:anywhere}
.pubs .m b{color:var(--ink);font-weight:600}
.pubs .m a{color:var(--accent);text-decoration:none}
.pubs .m a:hover{text-decoration:underline}

footer{border-top:1px solid var(--line);color:var(--muted);font-size:13px}
footer div{max-width:1180px;margin:0 auto;padding:20px clamp(16px,4vw,48px);display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:space-between}

@media (max-width:820px){
  .body{grid-template-columns:1fr;gap:0}
  .photo{width:132px;margin-top:-66px}
  .album{display:none}
}
@media (max-width:460px){
  .cv-list{grid-template-columns:1fr;gap:0}
  .cv-list dd{margin-bottom:10px}
  .pubs li{grid-template-columns:32px 1fr}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<nav class="nav">
  <div class="nav-in">
    <a class="brand serif" href="#top">{{ p.name }}</a>
    <ul>
      <li><a href="#research">Research</a></li>
      <li><a href="#publications">Publications</a></li>
    </ul>
  </div>
</nav>

<div class="banner" id="top"><img src="assets/banner.jpg" alt="" fetchpriority="high"></div>

<div class="body">
  <aside>
    <img class="photo" src="assets/profile.jpg" alt="{{ p.name }}" width="164" height="164">
    <h1 class="name serif">{{ p.name }}</h1>
    <p class="role">{{ p.position }}</p>
    <div class="icons">
      <a class="orcid" href="https://orcid.org/{{ orcid }}" target="_blank" rel="noopener" aria-label="ORCID" title="ORCID">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.6"/><text x="12" y="16.2" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="10.5" fill="currentColor">iD</text></svg>
      </a>
      <a class="rg" href="{{ p.links.researchgate }}" target="_blank" rel="noopener" aria-label="ResearchGate" title="ResearchGate">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1.5" y="1.5" width="21" height="21" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><text x="10.5" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="11" fill="currentColor">R</text><text x="16.6" y="11.2" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="7" fill="currentColor">G</text></svg>
      </a>
      <a class="li" href="{{ p.links.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1.5" y="1.5" width="21" height="21" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><text x="12" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="11" fill="currentColor">in</text></svg>
      </a>
      <button type="button" class="mail" data-code="{{ email_code }}" aria-label="Copy email address" title="Copy email address">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M3 6.5l9 6.5 9-6.5"/></svg>
      </button>
    </div>
    <a class="cv" href="{{ cv_file }}" download>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-5-5m5 5l5-5M4 19h16"/></svg>
      Download CV
    </a>
    {% if p.photos and p.photos.album %}
    <div class="album">
      {% for ph in p.photos.album %}{% set c = ph.crop %}<a{% if ph.wide %} class="wide"{% endif %} href="assets/photos/album/{{ ph.src }}" style="aspect-ratio:{{ ph.ratio }}"><img src="assets/photos/album/{{ ph.src }}" alt="{{ ph.alt }}" loading="lazy" style="width:{{ '%.2f'|format(100 / c[2]) }}%;left:-{{ '%.2f'|format(100 * c[0] / c[2]) }}%;top:-{{ '%.2f'|format(100 * c[1] / c[3]) }}%"></a>{% endfor %}
    </div>
    {% endif %}
  </aside>

  <main>
    {% macro lede() %}{% set k = p.summary_emphasis %}{% if k and k in p.summary %}{% set parts = p.summary.split(k, 1) %}{{ parts[0] }}<strong>{{ k }}</strong>{{ parts[1] }}{% else %}{{ p.summary }}{% endif %}{% endmacro %}
    <p class="lede serif">{{ lede() }}</p>

    <section id="research">
      <h2 class="sec serif">Research</h2>
      <div class="themes">
        {% for r in p.research %}
        <div><b>{{ r.title }}</b><p>{{ r.text }}</p></div>
        {% endfor %}
      </div>
    </section>

    <section>
      <h2 class="sec serif">Education &amp; Experience</h2>
      <dl class="cv-list">
        {% for r in timeline %}<dt>{{ r.span }}</dt><dd>{{ r.text }}</dd>{% endfor %}
      </dl>
    </section>

    <section id="publications">
      <h2 class="sec serif">Publications</h2>
      <div class="pubgroups">
        {% for g in pubs %}
        <div>
          <h3 class="grp">{{ g.key }}</h3>
          <ul class="pubs">
            {% for w in g["items"] %}
            <li><span class="no">[{{ w.no }}]</span><span><span class="t serif">{{ w.title }}</span><span class="m">{{ w.authors }}, {{ w.year }} · <i>{{ w.source }}</i>{% if w.doi %} · <a href="https://doi.org/{{ w.doi }}" target="_blank" rel="noopener">doi: {{ w.doi }}</a>{% endif %}</span></span></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </section>
  </main>
</div>

{% if p.photos and p.photos.scenery %}<div class="scenery-wrap">
<img class="scenery" src="assets/photos/{{ p.photos.scenery.src }}" alt="{{ p.photos.scenery.alt }}" loading="lazy">
{% endif %}
<footer><div>
  <span>© {{ updated[:4] }} {{ p.name }}</span>
  <span>Publications synced from <a href="https://orcid.org/{{ orcid }}" target="_blank" rel="noopener">ORCID</a> · last update {{ updated }}</span>
</div></footer>
{% if p.photos and p.photos.scenery %}</div>{% endif %}
{% if p.photos and p.photos.album %}
<dialog class="lb" id="lb"><img alt=""></dialog>
<script>
(() => {
  const lb = document.getElementById("lb"), big = lb.querySelector("img");
  document.querySelectorAll(".album a").forEach(a => a.addEventListener("click", e => {
    e.preventDefault(); big.src = a.href; big.alt = a.querySelector("img").alt; lb.showModal();
  }));
  lb.addEventListener("click", () => lb.close());
})();
</script>
{% endif %}
<dialog class="check" id="check" aria-labelledby="check-title">
  <form method="dialog" id="check-form">
    <h2 class="serif" id="check-title">Copy email address</h2>
    <p>A quick check that you are not a bot.</p>
    <label for="check-answer" id="check-q"></label>
    <input id="check-answer" inputmode="numeric" autocomplete="off" required>
    <p class="err" id="check-err" role="alert"></p>
    <p class="manual" id="check-manual" hidden></p>
    <div class="row"><button type="button" id="check-cancel">Cancel</button><button type="submit">Copy</button></div>
  </form>
</dialog>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
(() => {
  const btn = document.querySelector(".icons .mail"), dlg = document.getElementById("check"),
    form = document.getElementById("check-form"), q = document.getElementById("check-q"),
    ans = document.getElementById("check-answer"), err = document.getElementById("check-err"),
    manual = document.getElementById("check-manual"), toast = document.getElementById("toast");
  let sum = 0, done = false;
  const toastMsg = t => { toast.textContent = t; toast.classList.add("show"); clearTimeout(toast.t); toast.t = setTimeout(() => toast.classList.remove("show"), 2600); };
  btn.addEventListener("click", () => {
    const a = 2 + Math.floor(Math.random() * 8), b = 2 + Math.floor(Math.random() * 8);
    sum = a + b; done = false;
    q.textContent = `What is ${a} + ${b}?`;
    ans.value = ""; err.textContent = ""; manual.hidden = true; ans.hidden = false;
    form.querySelector("[type=submit]").hidden = false;
    dlg.showModal(); ans.focus();
  });
  document.getElementById("check-cancel").addEventListener("click", () => dlg.close());
  form.addEventListener("submit", async e => {
    e.preventDefault();
    if (parseInt(ans.value, 10) !== sum) { err.textContent = "That is not right. Please try again."; ans.select(); return; }
    const email = atob(btn.dataset.code).split("").reverse().join("");
    try {
      await navigator.clipboard.writeText(email);
      dlg.close(); toastMsg("Email address copied to clipboard");
    } catch {
      err.textContent = "Copying is blocked in this browser. Please copy it below.";
      manual.textContent = email; manual.hidden = false; ans.hidden = true;
      form.querySelector("[type=submit]").hidden = true;
    }
  });
})();
</script>
</body>
</html>
