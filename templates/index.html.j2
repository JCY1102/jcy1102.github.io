<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ p.name }} | Limnology & Freshwater Ecology</title>
<meta name="description" content="{{ p.name }}, {{ p.position }}. {{ p.summary }}">
<meta property="og:title" content="{{ p.name }}">
<meta property="og:description" content="{{ p.position }}">
<meta property="og:image" content="assets/banner.jpg">
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Public+Sans:wght@400;500;600&display=swap">
<style>
:root{--bg:#FAFBFA;--ink:#16211F;--muted:#5E6B68;--line:#DDE3E1;--accent:#0F5E5A;--tint:#E6F0EE;color-scheme:light}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Public Sans",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
a:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
.serif{font-family:"Newsreader",Georgia,"Times New Roman",serif}

.nav{position:sticky;top:0;z-index:5;background:rgba(250,251,250,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav-in{max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px clamp(16px,4vw,48px)}
.brand{font-size:19px;font-weight:500;text-decoration:none}
.nav ul{display:flex;align-items:center;gap:clamp(14px,2.5vw,26px);list-style:none;margin:0;padding:0;font-size:14px;color:var(--muted)}
.nav ul a{text-decoration:none}
.nav ul a:hover{color:var(--ink)}

.banner{height:clamp(160px,26vw,300px);background:var(--tint);overflow:hidden}
.banner img{width:100%;height:100%;object-fit:cover;object-position:50% 45%;display:block}

.body{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:minmax(260px,300px) 1fr;gap:clamp(28px,5vw,72px);padding:0 clamp(16px,4vw,48px) 72px}
aside{display:flex;flex-direction:column;gap:16px;align-self:start;position:sticky;top:64px}
.photo{width:164px;height:auto;max-width:100%;aspect-ratio:1;border-radius:50%;margin-top:-82px;border:5px solid var(--bg);object-fit:cover;background:var(--tint);display:block}
h1.name{font-weight:500;font-size:36px;line-height:1.1;margin:0;letter-spacing:-.01em}
.role{color:var(--muted);margin:0;font-size:14px}
.icons{display:flex;gap:10px;flex-wrap:wrap}
.icons a{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;color:var(--accent);background:#fff;transition:background .15s,border-color .15s,color .15s}
.icons a:hover{color:#fff;border-color:transparent}
.icons a.orcid:hover{background:#A6CE39}
.icons a.rg:hover{background:#00CCBB}
.icons a.li:hover{background:#0A66C2}
.icons a.mail:hover{background:var(--accent)}
.icons svg{width:20px;height:20px;display:block}
.email{font-size:13.5px;color:var(--muted);margin:-4px 0 0;overflow-wrap:anywhere}
.cv{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;text-decoration:none;background:var(--accent);color:#fff;padding:9px 16px;border-radius:6px}
.cv:hover{background:#0B4B48}
.cv svg{width:16px;height:16px}

main{display:flex;flex-direction:column;gap:48px;min-width:0;padding-top:clamp(28px,4vw,44px)}
.lede{font-size:clamp(20px,2.2vw,25px);line-height:1.45;margin:0;max-width:34em;text-wrap:pretty}
h2.sec{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin:0 0 16px;font-weight:600}
.themes{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px}
.themes div{border-top:1px solid var(--ink);padding-top:10px}
.themes b{display:block;font-weight:600;margin-bottom:4px}
.themes p{margin:0;color:var(--muted);font-size:14px}
.cv-list{display:grid;grid-template-columns:110px 1fr;gap:10px 18px;margin:0;font-size:14.5px}
.cv-list dt{color:var(--muted);font-variant-numeric:tabular-nums}
.cv-list dd{margin:0}
.sub{margin:22px 0 10px;font-size:13px;font-weight:600;color:var(--muted)}

.pubgroups{display:flex;flex-direction:column;gap:36px}
h3.grp{margin:0 0 16px;display:flex;align-items:baseline;gap:10px;font-size:22px;font-weight:500;padding-bottom:8px;border-bottom:1px solid var(--line)}
h3.grp small{font-family:"Public Sans",system-ui,sans-serif;font-size:12.5px;color:var(--muted);font-weight:400}
.pubs{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px}
.pubs li{display:grid;grid-template-columns:40px 1fr;gap:10px;font-size:14px}
.pubs .no{font-variant-numeric:tabular-nums;color:var(--accent);font-weight:500;padding-top:3px}
.pubs .t{font-size:17.5px;line-height:1.38;display:block;margin-bottom:4px}
.pubs .m{color:var(--muted);overflow-wrap:anywhere}
.pubs .m b{color:var(--ink);font-weight:600}
.pubs .m a{color:var(--accent);text-decoration:none}
.pubs .m a:hover{text-decoration:underline}

footer{border-top:1px solid var(--line);color:var(--muted);font-size:13px}
footer div{max-width:1180px;margin:0 auto;padding:20px clamp(16px,4vw,48px);display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:space-between}

@media (max-width:820px){
  .body{grid-template-columns:1fr;gap:0}
  aside{position:static}
  .photo{width:132px;margin-top:-66px}
}
@media (max-width:460px){
  .cv-list{grid-template-columns:1fr;gap:0}
  .cv-list dd{margin-bottom:10px}
  .pubs li{grid-template-columns:32px 1fr}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<nav class="nav">
  <div class="nav-in">
    <a class="brand serif" href="#top">{{ p.name }}</a>
    <ul>
      <li><a href="#research">Research</a></li>
      <li><a href="#publications">Publications</a></li>
      <li><a href="{{ cv_file }}" download>CV</a></li>
    </ul>
  </div>
</nav>

<div class="banner" id="top"><img src="assets/banner.jpg" alt="" fetchpriority="high"></div>

<div class="body">
  <aside>
    <img class="photo" src="assets/profile.jpg" alt="{{ p.name }}" width="164" height="164">
    <h1 class="name serif">{{ p.name }}</h1>
    <p class="role">{{ p.position }}</p>
    <div class="icons">
      <a class="orcid" href="https://orcid.org/{{ orcid }}" target="_blank" rel="noopener" aria-label="ORCID" title="ORCID">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.6"/><text x="12" y="16.2" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="10.5" fill="currentColor">iD</text></svg>
      </a>
      <a class="rg" href="{{ p.links.researchgate }}" target="_blank" rel="noopener" aria-label="ResearchGate" title="ResearchGate">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1.5" y="1.5" width="21" height="21" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><text x="10.5" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="11" fill="currentColor">R</text><text x="16.6" y="11.2" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="7" fill="currentColor">G</text></svg>
      </a>
      <a class="li" href="{{ p.links.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1.5" y="1.5" width="21" height="21" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><text x="12" y="16.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="11" fill="currentColor">in</text></svg>
      </a>
      <a class="mail" href="mailto:{{ p.email }}" aria-label="Email" title="{{ p.email }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M3 6.5l9 6.5 9-6.5"/></svg>
      </a>
    </div>
    <p class="email">{{ p.email }}</p>
    <a class="cv" href="{{ cv_file }}" download>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-5-5m5 5l5-5M4 19h16"/></svg>
      Download CV
    </a>
  </aside>

  <main>
    <p class="lede serif">{{ p.summary }}</p>

    <section id="research">
      <h2 class="sec">Research</h2>
      <div class="themes">
        {% for r in p.research %}
        <div><b>{{ r.title }}</b><p>{{ r.text }}</p></div>
        {% endfor %}
      </div>
    </section>

    <section>
      <h2 class="sec">Education &amp; Experience</h2>
      <dl class="cv-list">
        {% for r in timeline %}<dt>{{ r.span }}</dt><dd>{{ r.text }}</dd>{% endfor %}
      </dl>
      {% if licenses %}
      <p class="sub">Licenses</p>
      <dl class="cv-list">
        {% for r in licenses %}<dt>{{ r.start }}</dt><dd>{{ r.text }}</dd>{% endfor %}
      </dl>
      {% endif %}
    </section>

    <section id="publications">
      <div class="pubgroups">
        {% for g in pubs %}
        <div>
          <h3 class="grp serif">{% if g.key in ["SCIE","KCI"] %}Publications ({{ g.key }}){% else %}{{ g.key }}{% endif %}
            <small>{{ g["items"]|length }} paper{{ "s" if g["items"]|length > 1 }}</small></h3>
          <ul class="pubs">
            {% for w in g["items"] %}
            <li><span class="no">[{{ w.no }}]</span><span><span class="t serif">{{ w.title }}</span><span class="m">{{ w.authors }}, {{ w.year }} · <i>{{ w.source }}</i>{% if w.doi %} · <a href="https://doi.org/{{ w.doi }}" target="_blank" rel="noopener">doi: {{ w.doi }}</a>{% endif %}</span></span></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </section>
  </main>
</div>

<footer><div>
  <span>© {{ updated[:4] }} {{ p.name }}</span>
  <span>Publications synced from <a href="https://orcid.org/{{ orcid }}" target="_blank" rel="noopener">ORCID</a> · last update {{ updated }}</span>
</div></footer>
</body>
</html>
